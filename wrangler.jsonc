
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scaling-fortnight",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
